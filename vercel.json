{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.php", "use": "@vercel/php" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "img/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/home", "dest": "/home.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/delivery", "dest": "/delivery.html" },
    { "src": "/login", "dest": "/login.php" },
    { "src": "/signup", "dest": "/signup.php" },
    { "src": "/signin", "dest": "/signin.php" },
    { "src": "/profile", "dest": "/profile.php" },
    { "src": "/fooddonate", "dest": "/fooddonateform.php" },
    { "src": "/feedback", "dest": "/feedback.php" },
    { "src": "/logout", "dest": "/logout.php" },
    { "src": "/(.*)\\.php", "dest": "/$1.php" },
    { "src": "/(.*)\\.html", "dest": "/$1.html" },
    { "src": "/(.*)\\.css", "dest": "/$1.css" },
    { "src": "/(.*)\\.js", "dest": "/$1.js" },
    { "src": "/img/(.*)", "dest": "/img/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "PHP_VERSION": "8.0"
  }
} 